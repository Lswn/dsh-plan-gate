{
  "name": "dsh-plan-gate",
  "version": "0.1.1",
  "description": "Plan Gate 方案闸门：用户批准方案与工具清单之前，执行权不在模型手里。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plan",
    "approval",
    "confirm",
    "gate"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lswn/dsh-plan-gate.git"
  },
  "homepage": "https://github.com/Lswn/dsh-plan-gate#readme",
  "bugs": {
    "url": "https://github.com/Lswn/dsh-plan-gate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/rules.test.mjs && node test/gate.test.mjs && node test/stress.test.mjs && node test/amend.test.mjs && node test/stress2.test.mjs"
  }
}
